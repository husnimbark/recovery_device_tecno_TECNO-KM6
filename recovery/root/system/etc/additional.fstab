# Additional fstab used by PBRP/TWRP specifically for FBE decryption.
# This is intentionally separate from recovery.fstab.
# Do not remove — without this file, "E:Unable to decrypt FBE device" will occur.
# Must be kept in sync with recovery.fstab /data entry.

/dev/block/by-name/userdata /data f2fs noatime,nosuid,nodev,discard,noflush_merge,fsync_mode=nobarrier,reserve_root=134217,resgid=1065,inlinecrypt wait,check,formattable,latemount,fileencryption=aes-256-xts:aes-256-cts:v2+inlinecrypt_optimized,keydirectory=/metadata/vold/metadata_encryption,quota,reservedsize=128m,length=-16384
