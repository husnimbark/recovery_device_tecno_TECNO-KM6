# Android fstab file.
# The filesystem that contains the filesystem checker binary (typically /system) cannot
# specify MF_CHECK, and must come before any filesystems that do specify MF_CHECK

#<src>				<mnt_point>	<type>		<mnt_flags and options>								<fs_mgr_flags>
# Logical partitions
system				/system		auto		ro											wait,slotselect,logical,first_stage_mount
vendor				/vendor		auto		ro											wait,slotselect,logical,first_stage_mount
product				/product	auto		ro											wait,slotselect,logical,first_stage_mount
system_ext			/system_ext	auto		ro											wait,slotselect,logical,first_stage_mount
vendor_dlkm			/vendor_dlkm	auto		ro											wait,slotselect,logical,first_stage_mount
odm_dlkm			/odm_dlkm	auto		ro											wait,slotselect,logical,first_stage_mount
odm				/odm		auto		ro											wait,slotselect,logical,first_stage_mount,nofail,backup=1,flashimg=1
system_dlkm			/system_dlkm	auto		ro											wait,slotselect,logical,first_stage_mount,nofail,backup=1,flashimg=1

# Userdata & metadata
/dev/block/by-name/metadata	/metadata	ext4		noatime,nosuid,nodev,discard							wait,check,formattable,first_stage_mount,backup=1,flashimg=1
/dev/block/by-name/userdata	/data		f2fs		noatime,nosuid,nodev,discard,noflush_merge,fsync_mode=nobarrier,reserve_root=134217,resgid=1065,inlinecrypt	wait,check,formattable,latemount,fileencryption=aes-256-xts:aes-256-cts:v2+inlinecrypt_optimized,keydirectory=/metadata/vold/metadata_encryption,quota,reservedsize=128m,length=-16384

# misc - required by update_engine to determine boot device address
/dev/block/by-name/misc		/misc		emmc		defaults								defaults

# Cache (tranfs)
/dev/block/by-name/tranfs	/cache		ext4		noatime,nosuid,nodev,discard							wait,check,formattable,nofail

# Persist (backup & flash only — wipe disabled, wiping this can be dangerous/brick-prone)
/dev/block/by-name/persist	/persist	ext4	noatime,nosuid,nodev,noauto_da_alloc,commit=1,nodelalloc			wait,check,formattable,backup=1,flashimg=1,wipeingui=0,canbewiped=0

# Extra partitions for Install-Image (flashimg) and Backup/Restore in the OrangeFox GUI
#<mnt_point>	<fstype>	<device>				<flags>
/lk		emmc		/dev/block/by-name/lk			flags=display="LK (Bootloader)";backup=1;flashimg=1
/logo		emmc		/dev/block/by-name/logo		flags=display="Logo";backup=1;flashimg=1
