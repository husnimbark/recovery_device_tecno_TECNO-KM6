# Android fstab file.
# The filesystem that contains the filesystem checker binary (typically /system) cannot
# specify MF_CHECK, and must come before any filesystems that do specify MF_CHECK

#<src>				<mnt_point>	<type>		<mnt_flags and options>								<fs_mgr_flags>
# Logical partitions
system				/system		auto		ro											wait,slotselect,logical,first_stage_mount
vendor				/vendor		auto		ro											wait,slotselect,logical,first_stage_mount
product				/product	auto		ro											wait,slotselect,logical,first_stage_mount
system_ext			/system_ext	auto		ro											wait,slotselect,logical,first_stage_mount
vendor_dlkm			/vendor_dlkm	auto		ro											wait,slotselect,logical,first_stage_mount
odm_dlkm			/odm_dlkm	auto		ro											wait,slotselect,logical,first_stage_mount

# Transsion logical partitions
tr_carrier			/tr_carrier	auto		ro											wait,slotselect,logical,nofail
tr_company			/tr_company	auto		ro											wait,slotselect,logical,nofail
tr_mi				/tr_mi		auto		ro											wait,slotselect,logical,nofail
tr_overlayfs			/tr_overlayfs	auto		ro											wait,slotselect,logical,nofail
tr_preload			/tr_preload	auto		ro											wait,slotselect,logical,nofail
tr_product			/tr_product	auto		ro											wait,slotselect,logical,nofail
tr_region			/tr_region	auto		ro											wait,slotselect,logical,nofail
tr_theme			/tr_theme	auto		ro											wait,slotselect,logical,nofail

# Userdata & metadata
/dev/block/by-name/metadata	/metadata	ext4		noatime,nosuid,nodev,discard							wait,check,formattable,first_stage_mount
/dev/block/by-name/userdata	/data		f2fs		noatime,nosuid,nodev,discard,noflush_merge,fsync_mode=nobarrier,reserve_root=134217,resgid=1065,inlinecrypt	wait,check,formattable,fileencryption=aes-256-xts:aes-256-cts:v2+inlinecrypt_optimized,keydirectory=/metadata/vold/metadata_encryption,quota,reservedsize=128m

# misc - required by update_engine to determine boot device address
/dev/block/by-name/misc		/misc		emmc		defaults								defaults

# Cache (tranfs)
/dev/block/by-name/tranfs	/cache		ext4		noatime,nosuid,nodev,discard							wait,check,formattable,nofail

# Persist
/dev/block/by-name/persist	/persist	ext4	noatime,nosuid,nodev,noauto_da_alloc,commit=1,nodelalloc			wait,check,formattable

# USB OTG
/dev/block/sda     /usb_otg    auto    defaults    defaults
/dev/block/sda1    /usb_otg    auto    defaults    defaults
/dev/block/sdd1    /usb_otg    auto    defaults    defaults
