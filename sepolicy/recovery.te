# Recovery SELinux policy for TECNO KM6
# Fixes AVC denied warnings seen in logcat during PBRP boot

# Allow recovery to add to service_manager
allow recovery service_manager_service:service_manager add;
allow recovery service_manager_vndservice:service_manager add;

# Allow recovery to add to hwservice_manager
allow recovery hidl_base_hwservice:hwservice_manager add;
allow recovery hidl_manager_hwservice:hwservice_manager add;
allow recovery hidl_token_hwservice:hwservice_manager add;
allow recovery hal_bootctl_hwservice:hwservice_manager add;

# Allow recovery to find keymint and sharedsecret services
allow recovery hal_keymint_service:service_manager find;
allow recovery hal_sharedsecret_service:service_manager find;
